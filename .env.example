# Copy to `.env` and fill in. `.env` is gitignored and gitleaks blocks any commit that
# would carry a credential, so the secrets never reach the repository.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   uv run mlops secrets      # says which ones are loaded, without printing them
#
# Two prefixes: MLOPS_* is the core's (any domain), COFFEE_* belongs to the coffee
# domain, which reads its own credentials. A second domain brings its own prefix.

# Root directory for the raw / clean / features layers.
MLOPS_DATA_DIR=data

# MLflow tracking server (docker compose --profile ml up -d).
MLOPS_MLFLOW_TRACKING_URI=http://localhost:5000

# Which domain a command runs when none is named. Unset, the only installed one.
# MLOPS_DOMAIN=coffee

# --- Stage 2 credentials (both free; leave empty until stage 2) ------------------
# INEGI DENUE, for georeferenced establishments in Mexico City.
# Register at https://inegi.org.mx/app/desarrolladores/generatoken/Usuarios/token_Verify
# and the token arrives by email. It travels in the URL path, so nothing logs request
# URLs (see mlops_core/data/api.py).
COFFEE_DENUE_TOKEN=

# USDA FAS Open Data, for PSD, GATS and Export Sales programmatically.
# Register at https://apps.fas.usda.gov/opendataweb/ and generate a key in the portal.
# The live API is https://api.fas.usda.gov/api/ and the key travels in an `X-Api-Key`
# header. (The older apps.fas.usda.gov/OpenData host answers 500 to any key.)
COFFEE_USDA_FAS_API_KEY=
