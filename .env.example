# Copy to `.env` and fill in. `.env` is gitignored and gitleaks blocks any commit that
# would carry a credential, so the secrets never reach the repository.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   uv run mlops secrets      # says which ones are loaded, without printing them
#
# Two prefixes: MLOPS_* is the core's (any domain), COFFEE_* belongs to the coffee
# domain, which reads its own credentials. A second domain brings its own prefix.

# Root directory for the raw / clean / features layers.
MLOPS_DATA_DIR=data

# MLflow tracking server (docker compose --profile ml up -d).
MLOPS_MLFLOW_TRACKING_URI=http://localhost:5000

# Which domain a command runs when none is named. Unset, the only installed one.
# MLOPS_DOMAIN=coffee

# Dagster's schedule and sensors start off: the project runs by hand. A deployment meant
# to keep its own history turns them all on (see docs/cloud-plan.md).
# MLOPS_AUTOMATE=true

# --- Hosted models the agent may ask before its local one: all optional --------------
# providers.yaml lists them in the order they are asked; a provider is used only if its
# key is set here. When one runs out of free quota the next is asked, and the local model
# (Ollama) is always the last. `uv run mlops agent providers` shows who is set and who is
# set aside. Free tiers may use the prompts to train (Gemini outside the EU, Mistral):
# the prompts carry the data dictionary, query results and document passages.
# Google AI Studio, free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, free: https://console.groq.com/keys
GROQ_API_KEY=
# Mistral, free mode: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# OpenRouter, free models: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Cerebras, a 30-day trial that asks for a card: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Paid, used only with MLOPS_PAID_PROVIDERS=true:
#   Anthropic https://console.anthropic.com/settings/keys, OpenAI https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# MLOPS_PAID_PROVIDERS=true
# Ask only one model: local, or a provider's name. Unset, the whole chain answers.
# MLOPS_GENERATOR=local
# Replies kept by prompt (a prompt asked before costs nothing). Evaluations never use it.
# MLOPS_REPLY_CACHE=false

# --- The coffee domain's credentials: both free, both optional --------------------
# Without them everything builds except DENUE's register of establishments and the FAS
# API's cross-check of the PSD file; `make extract` says which it skipped and why.
# INEGI DENUE, for georeferenced establishments in Mexico City.
# Register at https://inegi.org.mx/app/desarrolladores/generatoken/Usuarios/token_Verify
# and the token arrives by email. It travels in the URL path, so nothing logs request
# URLs (see mlops_core/data/api.py).
COFFEE_DENUE_TOKEN=

# USDA FAS Open Data, for PSD, GATS and Export Sales programmatically.
# Register at https://apps.fas.usda.gov/opendataweb/ and generate a key in the portal.
# The live API is https://api.fas.usda.gov/api/ and the key travels in an `X-Api-Key`
# header. (The older apps.fas.usda.gov/OpenData host answers 500 to any key.)
COFFEE_USDA_FAS_API_KEY=
