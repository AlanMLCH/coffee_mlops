# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Stage 1 sources need no credentials. API keys arrive in stage 2 (DENUE, USDA FAS).

# Root directory for the raw / clean / features layers.
COFFEE_DATA_DIR=data

# MLflow tracking server (docker compose up mlflow).
COFFEE_MLFLOW_TRACKING_URI=http://localhost:5000
