# --- Secrets: never commit ---------------------------------------------------
.env
.env.*
!.env.example
.venv
*.pem
*.key
kaggle.json
secrets/

# --- Local assistant context (kept out of the public repo) -------------------
CLAUDE.md
.claude/

# --- Data and artifacts: rebuilt by running the pipeline ---------------------
# Anchored with a leading slash: a bare `data/` also matches src/coffee_mlops/data/,
# which silently kept source files out of the repository until CI failed on them.
/data/
*.duckdb
*.duckdb.wal
*.parquet
/mlruns/
/mlartifacts/
/mlflow.db
/.dagster/
/.tmp_dagster_home*/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# --- Tooling caches ----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Notebooks and editors ---------------------------------------------------
.ipynb_checkpoints/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
